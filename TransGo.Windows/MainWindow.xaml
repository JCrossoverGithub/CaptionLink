<Window x:Class="TransGo.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TransGo Audio Test"
        Height="430"
        Width="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220">

    <Grid Margin="32">
        <Border Background="#162033"
                CornerRadius="16"
                Padding="28">

            <StackPanel>
                <TextBlock Text="TransGo"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Desktop audio capture test"
                           Margin="0,4,0,24"
                           FontSize="15"
                           Foreground="#AAB6CA"/>

                <TextBlock Text="Audio output device"
                           Margin="0,0,0,8"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="OutputDeviceComboBox"
                              Grid.Column="0"
                              Height="38"
                              Padding="8,4"
                              DisplayMemberPath="DisplayName"/>

                    <Button x:Name="RefreshDevicesButton"
                            Grid.Column="1"
                            Content="Refresh"
                            Width="90"
                            Height="38"
                            Margin="10,0,0,0"
                            Click="RefreshDevicesButton_Click"/>
                </Grid>

                <TextBlock x:Name="StatusText"
                           Text="Not listening"
                           Margin="0,0,0,10"
                           FontSize="16"
                           Foreground="White"/>

                <ProgressBar x:Name="AudioLevelMeter"
                             Height="24"
                             Minimum="0"
                             Maximum="100"
                             Value="0"/>

                <TextBlock x:Name="LevelText"
                           Text="Audio level: 0%"
                           Margin="0,8,0,0"
                           Foreground="#AAB6CA"/>

                <TextBlock x:Name="BytesText"
                           Text="Captured: 0 bytes"
                           Margin="0,4,0,22"
                           Foreground="#AAB6CA"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartButton"
                            Content="Start Listening"
                            Width="140"
                            Height="40"
                            Margin="0,0,12,0"
                            Click="StartButton_Click"/>

                    <Button x:Name="StopButton"
                            Content="Stop"
                            Width="100"
                            Height="40"
                            IsEnabled="False"
                            Click="StopButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>