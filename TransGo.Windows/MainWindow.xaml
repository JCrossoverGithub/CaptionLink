<Window x:Class="TransGo.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TransGo"
        Height="760"
        Width="620"
        MinHeight="650"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220">

    <Grid Margin="32">
        <Border Background="#162033"
                CornerRadius="16"
                Padding="28">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>
                    <TextBlock Text="TransGo"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Real-time desktop audio captions"
                               Margin="0,4,0,24"
                               FontSize="15"
                               Foreground="#AAB6CA"/>

                    <TextBlock Text="Audio output device"
                               Margin="0,0,0,8"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="OutputDeviceComboBox"
                                  Grid.Column="0"
                                  Height="38"
                                  Padding="8,4"
                                  DisplayMemberPath="DisplayName"/>

                        <Button x:Name="RefreshDevicesButton"
                                Grid.Column="1"
                                Content="Refresh"
                                Width="90"
                                Height="38"
                                Margin="10,0,0,0"
                                Click="RefreshDevicesButton_Click"/>
                    </Grid>

                    <TextBlock Text="Transcription provider"
                               Margin="0,0,0,8"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <ComboBox x:Name="TranscriptionProviderComboBox"
                              Height="38"
                              Padding="8,4"
                              Margin="0,0,0,22"
                              SelectedIndex="0">

                        <ComboBoxItem Content="Local — Parakeet GPU"
                                      Tag="parakeet"/>

                        <ComboBoxItem Content="Google Cloud"
                                      Tag="google"/>

                        <ComboBoxItem Content="Local — Sherpa Streaming"
                                      Tag="sherpa-streaming"/>

                        <ComboBoxItem Content="Local — Hybrid (Experimental)"
                                      Tag="hybrid"/>

                        <ComboBoxItem Content="Local — Whisper Turbo (Delayed)"
                                      Tag="whisper-turbo"/>
                    </ComboBox>

                    <TextBlock Text="Local caption quality"
                               Margin="0,0,0,8"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <ComboBox x:Name="ParakeetProfileComboBox"
                              Height="38"
                              Padding="8,4"
                              Margin="0,0,0,22"
                              SelectedIndex="1"
                              SelectionChanged="ParakeetProfileComboBox_SelectionChanged">
                        
                       <TextBlock Text="Speaker attribution"
                           Margin="0,0,0,8"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                                        <ComboBox x:Name="SpeakerAttributionComboBox"
                                          Height="38"
                                          Padding="8,4"
                                          Margin="0,0,0,22"
                                          SelectedIndex="0">

                                            <ComboBoxItem Content="Off"
                                                Tag="off"/>

                                            <ComboBoxItem Content="Simulated — Development"
                                                Tag="simulated"/>
                                            </ComboBox>

                        <ComboBoxItem Content="Responsive — lower latency"
                                      Tag="responsive"/>

                        <ComboBoxItem Content="Accurate — better context"
                                      Tag="accurate"/>
                    </ComboBox>

                    <TextBlock x:Name="StatusText"
                               Text="Not listening"
                               Margin="0,0,0,10"
                               FontSize="16"
                               Foreground="White"/>

                    <ProgressBar x:Name="AudioLevelMeter"
                                 Height="24"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"/>

                    <TextBlock x:Name="LevelText"
                               Text="Audio level: 0%"
                               Margin="0,8,0,0"
                               Foreground="#AAB6CA"/>

                    <TextBlock x:Name="BytesText"
                               Text="Captured: 0 bytes"
                               Margin="0,4,0,0"
                               Foreground="#AAB6CA"/>

                    <TextBlock x:Name="NormalizationText"
                               Text="Normalized chunks: 0"
                               Margin="0,4,0,18"
                               Foreground="#AAB6CA"/>

                    <TextBlock Text="Live transcript"
                               Margin="0,0,0,6"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <Border Height="150"
                            Padding="12"
                            CornerRadius="6"
                            Background="#0F1828"
                            BorderBrush="#33415C"
                            BorderThickness="1">

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <TextBlock x:Name="TranscriptText"
                                       Text="Waiting for speech..."
                                       TextWrapping="Wrap"
                                       FontSize="17"
                                       LineHeight="25"
                                       Foreground="White"/>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,20,0,0">

                        <Button x:Name="StartButton"
                                Content="Start Listening"
                                Width="140"
                                Height="40"
                                Margin="0,0,12,0"
                                Click="StartButton_Click"/>

                        <Button x:Name="StopButton"
                                Content="Stop"
                                Width="100"
                                Height="40"
                                IsEnabled="False"
                                Click="StopButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>