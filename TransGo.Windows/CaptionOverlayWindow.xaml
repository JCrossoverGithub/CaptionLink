<Window x:Class="TransGo.Windows.CaptionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TransGo Captions"
        Width="900"
        Height="150"
        MinWidth="400"
        MinHeight="100"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border x:Name="OverlayBorder"
            Padding="24"
            CornerRadius="14"
            Background="#E60B1220"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            MouseLeftButtonDown="OverlayBorder_MouseLeftButtonDown">

        <StackPanel x:Name="CaptionPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock x:Name="SpeakerLabelText"
                       Text=""
                       Margin="0,0,0,6"
                       TextAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#AAB6CA"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="CaptionText"
                       Text="Listening for speech..."
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="White"/>
        </StackPanel>
    </Border>
</Window>