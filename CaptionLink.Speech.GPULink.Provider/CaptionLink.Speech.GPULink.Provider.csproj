<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CaptionLink.Speech.GPULink\CaptionLink.Speech.GPULink.csproj" />
    <ProjectReference Include="$(GPULinkClientProject)" Condition="'$(GPULinkClientProject)' != ''" />
  </ItemGroup>
  <Target Name="RequireApprovedGPULinkClient" BeforeTargets="ResolveReferences" Condition="'$(GPULinkClientProject)' == ''">
    <Error Text="Specify -p:GPULinkClientProject=path/to/GPULink.Client.csproj. This is a development checkout reference, not a published dependency." />
  </Target>
</Project>
