{
  "manifest_version": 3,
  "name": "TransGo Live Captions",
  "description": "Captions audio from the active Chrome tab through a TransGo GPU gateway.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "action": {
    "default_title": "TransGo Live Captions",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "latency.js",
        "caption-state.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws: wss:"
  }
}
