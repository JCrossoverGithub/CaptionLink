<Window x:Class="CaptionLink.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CaptionLink"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#090E15"
        Foreground="#F6F8FB"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush"
                         Color="#111923"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush"
                         Color="#16212E"/>
        <SolidColorBrush x:Key="BorderBrush"
                         Color="#263547"/>
        <SolidColorBrush x:Key="MutedBrush"
                         Color="#91A0B3"/>
        <SolidColorBrush x:Key="AccentBrush"
                         Color="#776AF3"/>
        <SolidColorBrush x:Key="AccentSoftBrush"
                         Color="#201D3D"/>

        <Style TargetType="Button">
            <Setter Property="Height"
                    Value="40"/>
            <Setter Property="Padding"
                    Value="16,0"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="#1A2634"/>
            <Setter Property="BorderBrush"
                    Value="#34465D"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height"
                    Value="40"/>
            <Setter Property="Padding"
                    Value="10,4"/>
            <Setter Property="FontSize"
                    Value="14"/>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Product header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="CaptionLink"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Real-time captions for the audio playing on this computer"
                           Margin="0,4,0,0"
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="14,9"
                    CornerRadius="10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="STATUS"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}"/>

                    <TextBlock x:Name="StatusText"
                               Text="Not listening"
                               Margin="0,2,0,0"
                               MaxWidth="340"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="White"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main caption workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Captions are the primary product surface -->
            <Border Grid.Column="0"
                    Padding="26"
                    CornerRadius="14"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Live captions"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>

                            <TextBlock Text="Speaker-aware transcription appears here as the conversation happens."
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="10,6"
                                CornerRadius="12"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="#51499D"
                                BorderThickness="1"
                                VerticalAlignment="Top">

                            <TextBlock Text="MULTITALKER"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#C8C2FF"/>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="ActiveSpeakersText"
                               Grid.Row="1"
                               Margin="0,12,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}"
                               Visibility="Collapsed"/>

                    <Border Grid.Row="3"
                            Padding="26"
                            CornerRadius="10"
                            Background="#090F17"
                            BorderBrush="#202D3D"
                            BorderThickness="1">

                        <Grid>
                            <ScrollViewer x:Name="TranscriptScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          ScrollChanged="TranscriptScrollViewer_ScrollChanged">

                                <TextBlock x:Name="TranscriptText"
                                           Text="Waiting for speech..."
                                           Padding="0,0,0,56"
                                           TextWrapping="Wrap"
                                           FontSize="25"
                                           LineHeight="38"
                                           Foreground="White"/>
                            </ScrollViewer>

                            <Button x:Name="JumpToLiveButton"
                                    Content="Jump to live"
                                    Width="112"
                                    Height="36"
                                    Margin="0,0,12,12"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed"
                                    Click="JumpToLiveButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Small setup / settings rail -->
            <StackPanel Grid.Column="2">

                <Border Padding="18"
                        CornerRadius="14"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">

                    <StackPanel>
                        <TextBlock Text="Audio source"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <TextBlock Text="Choose the system output CaptionLink should listen to."
                                   Margin="0,4,0,12"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"/>

                        <ComboBox x:Name="OutputDeviceComboBox"
                                  DisplayMemberPath="DisplayName"/>

                        <Button x:Name="RefreshDevicesButton"
                                Content="Refresh devices"
                                Margin="0,10,0,0"
                                Click="RefreshDevicesButton_Click"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0"
                        Padding="18"
                        CornerRadius="14"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">

                    <StackPanel>
                        <TextBlock Text="Captioning"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <Border Margin="0,12,0,14"
                                Padding="12"
                                CornerRadius="9"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="#51499D"
                                BorderThickness="1">

                            <StackPanel>
                                <TextBlock Text="Multitalker"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>

                                <TextBlock Text="Default · multi-speaker captions with Nemotron 3 built in"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="#C8C2FF"/>
                            </StackPanel>
                        </Border>

                        <Expander Header="Advanced caption settings"
                                  IsExpanded="False">

                            <StackPanel Margin="0,14,0,0">

                                <TextBlock Text="Caption engine"
                                           Margin="0,0,0,6"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"/>

                                <ComboBox x:Name="TranscriptionProviderComboBox"
                                          SelectedIndex="0"
                                          SelectionChanged="TranscriptionProviderComboBox_SelectionChanged">
                                <ComboBoxItem Content="Local — Multitalker Parakeet"
                                Tag="multitalker-parakeet"/>

                                <ComboBoxItem Content="Local — Parakeet GPU"
                                Tag="parakeet"/>

                                <ComboBoxItem Content="Remote — CaptionLink GPU Gateway"
                                Tag="remote"/>

                                <ComboBoxItem Content="Google Cloud"
                                Tag="google"/>

                                <ComboBoxItem Content="Local — Sherpa Streaming"
                                Tag="sherpa-streaming"/>

                                <ComboBoxItem Content="Local — Hybrid (Experimental)"
                                Tag="hybrid"/>

                                <ComboBoxItem Content="Local — Whisper Turbo (Delayed)"
                                Tag="whisper-turbo"/>
                                </ComboBox>

                                <TextBlock Text="Parakeet quality"
                                           Margin="0,14,0,6"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"/>

                                <ComboBox x:Name="ParakeetProfileComboBox"
                                          SelectedIndex="1"
                                          SelectionChanged="ParakeetProfileComboBox_SelectionChanged">
                                <ComboBoxItem Content="Responsive — lower latency"
                                Tag="responsive"/>

                                <ComboBoxItem Content="Accurate — better context"
                                Tag="accurate"/>
                                </ComboBox>

                                <TextBlock Text="External speaker attribution"
                                           Margin="0,14,0,6"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"/>

                                <ComboBox x:Name="SpeakerAttributionComboBox"
                                          SelectedIndex="0">
                                <ComboBoxItem Content="Off"
                                Tag="off"/>

                                <ComboBoxItem Content="Simulated — Development"
                                Tag="simulated"/>

                                <ComboBoxItem Content="NVIDIA Sortformer - Local GPU"
                                Tag="sortformer"/>

                                <ComboBoxItem Content="NVIDIA Nemotron 3 - Local GPU"
                                Tag="nemotron"/>
                                </ComboBox>

                                <TextBlock x:Name="SpeakerAttributionHintText"
                                           Text="Included automatically: Multitalker uses Nemotron 3 for speaker detection."
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0"
                        Padding="18"
                        CornerRadius="14"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">

                    <Expander Header="Diagnostics"
                              IsExpanded="False">

                        <StackPanel Margin="0,14,0,0">

                            <ProgressBar x:Name="AudioLevelMeter"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"/>

                            <TextBlock x:Name="LevelText"
                                       Text="Audio level: 0%"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>

                            <TextBlock x:Name="BytesText"
                                       Text="Captured: 0 bytes"
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>

                            <TextBlock x:Name="NormalizationText"
                                       Text="Normalized chunks: 0"
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Session controls -->
        <Border Grid.Row="4"
                Padding="14"
                CornerRadius="12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="StartButton"
                        Grid.Column="0"
                        Content="Start captions"
                        MinWidth="138"
                        Background="{StaticResource AccentBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        Click="StartButton_Click"/>

                <Button x:Name="StopButton"
                        Grid.Column="2"
                        Content="Stop captions"
                        MinWidth="130"
                        IsEnabled="False"
                        Click="StopButton_Click"/>

                <TextBlock Grid.Column="4"
                           Text="Multitalker runs locally on your GPU."
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
